---
import { getTrails, type TrailEntry } from "../lib/trails";

/**
 * The trails *out* of an entry — the edges Dr Wip has actually laid: the
 * reflection a book argues with, the post a reflection complicates, the unread
 * book circling both. Works for any collection; renders nothing when the entry
 * connects to nothing yet.
 *
 * `compact` drops the section heading, for use inside a list item rather than
 * at the foot of a page.
 */
interface Props {
  entry: TrailEntry;
  compact?: boolean;
  class?: string;
}

const { entry, compact = false, class: className } = Astro.props;
const trails = await getTrails(entry);
---

{
  trails.length > 0 &&
    (compact ? (
      <ul class:list={["space-y-1", className]} aria-label="Trails">
        {trails.map((trail) => (
          <li class="text-sm leading-relaxed text-brand-muted">
            <span class="font-mono text-xs uppercase tracking-widest">
              {trail.kind}
            </span>{" "}
            <a
              href={trail.href}
              target={trail.external ? "_blank" : undefined}
              rel={trail.external ? "noopener noreferrer" : undefined}
              class="text-brand-accent underline underline-offset-2 hover:decoration-2"
            >
              {trail.title}
              {trail.external && " ↗"}
            </a>
            {trail.note && ` — ${trail.note}`}
          </li>
        ))}
      </ul>
    ) : (
      <section
        class:list={["mt-12 border-t border-brand-border pt-8", className]}
      >
        <h2 class="mb-3 font-mono text-xs uppercase tracking-widest text-brand-muted">
          Trails from here
        </h2>
        <ul class="space-y-3">
          {trails.map((trail) => (
            <li class="leading-relaxed">
              <span class="font-mono text-xs uppercase tracking-widest text-brand-muted">
                {trail.kind}
              </span>
              <a
                href={trail.href}
                target={trail.external ? "_blank" : undefined}
                rel={trail.external ? "noopener noreferrer" : undefined}
                class="ml-2 font-heading text-brand-text transition-colors hover:text-brand-accent"
              >
                {trail.title}
                {trail.external && " ↗"}
              </a>
              {trail.note && (
                <span class="mt-0.5 block text-sm text-brand-muted">
                  {trail.note}
                </span>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))
}
